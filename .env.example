# =====================================================================
# Face ID + Blockchain Verification Pipeline Configuration
# =====================================================================

# 1. Reverse-Image Search (Candidate Lead Discovery)
# Provide either Google Cloud Vision API Key or Service Account JSON path
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative Search Provider: Bing Visual Search API
BING_VISUAL_SEARCH_API_KEY=

# 2. Decentralized Storage (IPFS)
# Pinata API JWT (Recommended) or Key + Secret for pinning images & metadata
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# 3. Blockchain Testnet (Polygon Amoy / Ethereum Sepolia)
# Default RPC for Polygon Amoy Testnet (Chain ID 80002)
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Default RPC for Ethereum Sepolia Testnet (Chain ID 11155111)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Target RPC to use in pipeline
WEB3_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Testnet wallet private key (Funded via https://faucet.polygon.technology/)
WEB3_PRIVATE_KEY=

# Deployed FaceVerificationRegistry smart contract address (Run scripts/deploy_contract.py)
CONTRACT_ADDRESS=
